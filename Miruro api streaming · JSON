{
    "id": "miruro-api-streaming",
    "name": "Miruro API (self-hosted)",
    "description": "Online streaming provider backed by a self-hosted walterwhite-69/Miruro-API instance",
    "manifestURI": "https://raw.githubusercontent.com/tinman097/seanime-streamer/main/Miruro%20api%20streaming%20%C2%B7%20JSON",
    "version": "1.0.0",
    "author": "you",
    "type": "onlinestream-provider",
    "language": "typescript",
    "lang": "multi",
    "userConfig": {
        "requiresConfig": true,
        "version": 1,
        "fields": [
            {
                "name": "apiUrl",
                "label": "Miruro-API Base URL",
                "type": "text",
                "default": "http://localhost:8000"
            }
        ]
    },
    "payload": "/// <reference path=\"./online-streaming-provider.d.ts\" />\n\n// Seanime Online Streaming Provider for walterwhite-69/Miruro-API\n// https://github.com/walterwhite-69/Miruro-API\n//\n// This extension does NOT scrape anything itself - it just calls your\n// self-hosted Miruro-API instance (running on your Pi) and translates its\n// responses into the shape Seanime expects.\n//\n// {{apiUrl}} is replaced at load time with whatever the user enters in the\n// extension's config screen in Seanime (see manifest.json userConfig).\n\ntype MiruroEpisode = {\n    id: string          // e.g. \"watch/kiwi/178005/sub/animepahe-1\"\n    number: number\n    title?: string\n}\n\ntype MiruroEpisodesResponse = {\n    providers: {\n        [provider: string]: {\n            episodes: {\n                sub?: MiruroEpisode[]\n                dub?: MiruroEpisode[]\n            }\n        }\n    }\n}\n\ntype MiruroStream = {\n    url: string\n    type: string        // \"hls\" | ...\n    quality: string\n}\n\ntype MiruroSubtitle = {\n    file: string\n    label: string\n    kind: string\n}\n\ntype MiruroSourceResponse = {\n    streams: MiruroStream[]\n    subtitles?: MiruroSubtitle[]\n}\n\nclass Provider {\n\n    private api = \"{{apiUrl}}\"\n\n    getSettings(): Settings {\n        return {\n            // Miruro-API's known providers. If a given anime isn't available\n            // on one, findEpisodeServer() below will throw and Seanime will\n            // let the user try another.\n            episodeServers: [\"kiwi\", \"arc\", \"zoro\", \"jet\"],\n            supportsDub: true,\n        }\n    }\n\n    // Seanime already knows the AniList ID for the anime being searched, and\n    // Miruro-API is AniList-native, so we skip fuzzy title matching entirely\n    // and just pass the ID straight through, encoding the requested audio\n    // track (sub/dub) since findEpisodes() only receives this id back.\n    async search(opts: SearchOptions): Promise<SearchResult[]> {\n        const audio = opts.dub ? \"dub\" : \"sub\"\n        return [{\n            id: `${opts.media.id}::${audio}`,\n            title: opts.media.englishTitle || opts.media.romajiTitle || opts.query,\n            url: `${this.api}/info/${opts.media.id}`,\n            subOrDub: opts.dub ? \"dub\" : \"sub\",\n        }]\n    }\n\n    async findEpisodes(id: string): Promise<EpisodeDetails[]> {\n        const [anilistId, audio] = id.split(\"::\") as [string, \"sub\" | \"dub\"]\n\n        const res = await fetch(`${this.api}/episodes/${anilistId}`)\n        if (!res.ok) {\n            throw new Error(`Failed to fetch episode list (${res.status})`)\n        }\n        const data = (await res.json()) as MiruroEpisodesResponse\n\n        const providerNames = Object.keys(data.providers || {})\n        if (providerNames.length === 0) {\n            throw new Error(\"No providers returned episodes for this anime.\")\n        }\n\n        // Default to whichever provider has the most episodes for the\n        // requested audio track - just used for numbering/titles here.\n        let bestProvider = providerNames[0]\n        let bestCount = 0\n        for (const p of providerNames) {\n            const count = data.providers[p]?.episodes?.[audio]?.length ?? 0\n            if (count > bestCount) {\n                bestCount = count\n                bestProvider = p\n            }\n        }\n\n        const list = data.providers[bestProvider]?.episodes?.[audio] ?? []\n        if (list.length === 0) {\n            throw new Error(`No ${audio} episodes found on any provider.`)\n        }\n\n        const episodes: EpisodeDetails[] = list.map((ep) => ({\n            id: `${anilistId}::${ep.number}::${audio}`,\n            number: ep.number,\n            url: \"\",\n            title: ep.title,\n        }))\n\n        episodes.sort((a, b) => a.number - b.number)\n        return episodes\n    }\n\n    async findEpisodeServer(episode: EpisodeDetails, _server: string): Promise<EpisodeServer> {\n        const [anilistId, numberStr, audio] = episode.id.split(\"::\") as [string, string, \"sub\" | \"dub\"]\n        const server = _server === \"default\" ? \"kiwi\" : _server\n\n        // Re-fetch so we get this specific provider's watch-id for the episode.\n        const res = await fetch(`${this.api}/episodes/${anilistId}`)\n        if (!res.ok) {\n            throw new Error(`Failed to fetch episode list (${res.status})`)\n        }\n        const data = (await res.json()) as MiruroEpisodesResponse\n\n        const providerEpisodes = data.providers?.[server]?.episodes?.[audio]\n        if (!providerEpisodes || providerEpisodes.length === 0) {\n            throw new Error(`\"${server}\" has no ${audio} episodes for this anime. Try another server.`)\n        }\n\n        const match = providerEpisodes.find((e) => e.number === Number(numberStr))\n        if (!match) {\n            throw new Error(`Episode ${numberStr} not found on \"${server}\".`)\n        }\n\n        const sourceRes = await fetch(`${this.api}/${match.id}`)\n        if (!sourceRes.ok) {\n            throw new Error(`Failed to fetch stream sources (${sourceRes.status})`)\n        }\n        const sourceData = (await sourceRes.json()) as MiruroSourceResponse\n\n        if (!sourceData.streams || sourceData.streams.length === 0) {\n            throw new Error(\"No video sources returned for this episode.\")\n        }\n\n        const subtitles: VideoSubtitle[] = (sourceData.subtitles ?? []).map((sub, i) => ({\n            id: String(i),\n            url: sub.file,\n            language: sub.label,\n            isDefault: i === 0,\n        }))\n\n        const videoSources: VideoSource[] = sourceData.streams.map((s) => ({\n            url: s.url,\n            type: s.type === \"hls\" ? \"m3u8\" : \"mp4\",\n            quality: s.quality,\n            subtitles,\n        }))\n\n        return {\n            server: server,\n            headers: {},\n            videoSources,\n        }\n    }\n}\n"
}
